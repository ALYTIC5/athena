---
import { getEntry } from 'astro:content';
import { Code } from '@astrojs/starlight/components';
import { ExerciseIsland } from './ExerciseIsland';
import { publishedLessons } from '../lib/content/published';
import { url } from '../lib/url';

interface Props {
  id: string;
}

const { id } = Astro.props;
const exercise = await getEntry('exercises', id);
if (!exercise) throw new Error(`Unknown exercise: ${id}`);
const e = exercise.data;
const lessonTitle =
  (await publishedLessons()).find((l) => l.id === e.lesson)?.title ?? e.title ?? id;
---

<ExerciseIsland
  client:visible
  id={id}
  lessonTitle={lessonTitle}
  kind={e.kind}
  runtime={e.runtime}
  schema={e.schema}
  extensions={e.extensions}
  promptText={e.prompt}
  starter={e.starter}
  visibleTests={e.visibleTests ?? ''}
  timeoutMs={e.timeoutMs}
  packages={e.packages}
  dataUrl={url(`data/exercises/${id}.json`)}
>
  <Code code={e.starter} lang={e.runtime === 'sql' ? 'sql' : 'python'} />
</ExerciseIsland>
