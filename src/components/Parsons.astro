---
import { QuizIsland } from './quiz/QuizIsland';
import { assertItem } from '../lib/content/guards';

interface Props {
  lesson: string;
  item: string;
}

const { lesson, item } = Astro.props;
await assertItem(lesson, item, 'parsons', 'Parsons');
---

<QuizIsland client:visible lesson={lesson} item={item} />
