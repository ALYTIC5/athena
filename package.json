{
  "name": "athena",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . && prettier --check .",
    "typecheck": "astro check",
    "test": "vitest run",
    "validate": "tsx scripts/validate-content.ts",
    "e2e": "playwright test --project=chromium",
    "e2e:all": "playwright test",
    "size": "tsx scripts/check-size.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run validate && npm run build",
    "check:full": "npm run check && npm run e2e:all && npm run size"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@astrojs/starlight": "0.42.6",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "astro": "7.3.8",
    "astro-auto-import": "0.6.0",
    "codemirror": "6.0.2",
    "idb-keyval": "6.3.0",
    "pyodide": "314.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "starlight-links-validator": "0.27.0",
    "ts-fsrs": "5.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "1.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
